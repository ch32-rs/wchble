/* Slot A carrier: the 32 B image header sits at 0x4000, so the app starts
 * at 0x4020. `memory.x` is copied into OUT_DIR by build.rs. */
MEMORY
{
    CODEFLASH (rwx) : ORIGIN = 0x00004020, LENGTH = 0x35FE0
    DATAFLASH (rwx) : ORIGIN = 0x00070000, LENGTH = 32K
    /* 0x20000000..0x20000080 holds the boot manager's BOOT_STATS. */
    SRAM      (rwx) : ORIGIN = 0x20000080, LENGTH = 128K - 128
}

REGION_ALIAS("FLASH", CODEFLASH);

REGION_ALIAS("RAM", SRAM);
REGION_ALIAS("REGION_TEXT", CODEFLASH);
REGION_ALIAS("REGION_RODATA", CODEFLASH);
REGION_ALIAS("REGION_DATA", SRAM);
REGION_ALIAS("REGION_BSS", SRAM);
REGION_ALIAS("REGION_HEAP", SRAM);
REGION_ALIAS("REGION_STACK", SRAM);
